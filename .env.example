# Firebase Admin (Netlify Functions + السكربت المحلي)
# انسخ إلى .env واملأ القيم — لا تضع أسراراً حقيقية في هذا الملف
FIREBASE_PROJECT_ID=atherace-109b8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@atherace-109b8.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://atherace-109b8-default-rtdb.firebaseio.com

# Firebase Web (يُولَّد firebase-config.generated.js عند npm run build)
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=atherace-109b8.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=atherace-109b8
FIREBASE_WEB_DATABASE_URL=https://atherace-109b8-default-rtdb.firebaseio.com
FIREBASE_WEB_STORAGE_BUCKET=atherace-109b8.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_WEB_APP_ID=1:your-sender-id:web:your-app-id

# CORS — نطاق الإنتاج (يمكن عدة قيم مفصولة بفاصلة)
ALLOWED_ORIGIN=https://atherace-109b8.web.app
# ALLOWED_ORIGINS=https://staging.netlify.app,https://prod.netlify.app

# جلسة المشارك (JWT بعد التحقق من الكود) — سلسلة عشوائية طويلة
SESSION_SIGNING_SECRET=change-me-to-a-long-random-string

# أول مسؤول (createFirstAdmin / السكربت المحلي)
FIREBASE_ADMIN_EMAIL=admin@example.com
FIREBASE_ADMIN_PASSWORD=change-me-strong-password

# حماية دالة createFirstAdmin (مطلوب على الإنتاج) — POST + رأس X-Create-Admin-Secret فقط
CREATE_ADMIN_SECRET=change-me-create-admin-secret

# اختياري — تقييد استدعاء createFirstAdmin بعنوان IP واحد
# CREATE_ADMIN_ALLOWED_IP=203.0.113.10

# مطلوب على الإنتاج لإضافة مسؤولين عبر bootstrapAdmin بدون تسجيل دخول
BOOTSTRAP_SECRET=change-me-bootstrap-secret

# بيئة التشغيل (Netlify يضبطها تلقائياً في netlify.toml — يمكن تجاوزها)
# APP_ENV=production

# مراقبة الأخطاء (اختياري — Sentry)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=0

# إصدار سياسة الخصوصية (يُخزَّن مع موافقة المشارك)
PRIVACY_POLICY_VERSION=2026-05-18

# اختبار الحمل / Go-Live (محلي — لا تضفها على Netlify)
# LOAD_TEST_BASE_URL=https://develop--your-site.netlify.app
# LOAD_TEST_DURATION=30
# LOAD_TEST_CONCURRENCY=15
# SITE_URL=https://your-site.netlify.app
